# .env.local.example
# Skopiuj jako .env.local i uzupelnij wartosci.
# NIGDY nie commituj pliku .env.local do repozytorium!

# ── MariaDB ───────────────────────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=password

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASS=haslo123
MONGO_DB=pj_sylabi

# PostgreSQL — Schedule API
SCHEDULE_POSTGRES_DB=pj_schedule
SCHEDULE_POSTGRES_USER=shogun_schedule
SCHEDULE_POSTGRES_PASSWORD=schedule_password

# Backup MariaDB + PostgreSQL
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_SECONDS=172800
BACKUP_RUN_ON_STARTUP=true
BACKUP_TIMEZONE=Europe/Warsaw

# ── Keycloak (baza) ───────────────────────────────────────────────────────────
KC_DB_USER=root
KC_DB_PASS=password

# ── Keycloak (admin) ──────────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASS=admin_pass

# ── Users API (uzupelnij po terraform apply) ──────────────────────────────────
# terraform output -raw users_service_client_secret
USERS_SERVICE_CLIENT_SECRET=
