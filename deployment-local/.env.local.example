# .env.local.example
# Skopiuj jako .env.local i uzupelnij wartosci.
# NIGDY nie commituj pliku .env.local do repozytorium!

# ── MariaDB ───────────────────────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=password

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASS=haslo123
MONGO_DB=pj_sylabi

# ── Keycloak (baza) ───────────────────────────────────────────────────────────
KC_DB_USER=root
KC_DB_PASS=password

# ── Keycloak (admin) ──────────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASS=admin_pass

# ── Users API (uzupelnij po terraform apply) ──────────────────────────────────
# terraform output -raw users_service_client_secret
USERS_SERVICE_CLIENT_SECRET=
