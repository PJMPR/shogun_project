{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "npm", "analytics": false },
  "projects": {
    "pj-studies-lecturer-schedule": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/pj-studies-lecturer-schedule",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "es-module-shims.js", "input": "node_modules/es-module-shims/dist/", "output": "/" }],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "1MB", "maximumError": "5MB" }, { "type": "anyComponentStyle", "maximumWarning": "8kB", "maximumError": "12kB" }] },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "port": 4207 }, "configurations": { "development": { "buildTarget": "pj-studies-lecturer-schedule:build:development" } }, "defaultConfiguration": "development" },
        "serve-mfe": { "builder": "@angular-architects/native-federation:build", "options": { "target": "pj-studies-lecturer-schedule:serve:development", "federationConfig": "federation.config.js", "verbose": false } },
        "build-mfe": { "builder": "@angular-architects/native-federation:build", "options": { "target": "pj-studies-lecturer-schedule:build:production", "federationConfig": "federation.config.js", "verbose": false }, "configurations": { "production": { "target": "pj-studies-lecturer-schedule:build:production" } } },
        "test": { "builder": "@angular/build:unit-test" }
      }
    }
  }
}
