# .env.prod.example
# Skopiuj jako .env.prod i uzupelnij wartosci przed wdrozeniem.
# NIGDY nie commituj pliku .env.prod do repozytorium!

# ── Domena ───────────────────────────────────────────────────────────────────
# Uzywana w konfiguracji Keycloak valid issuers
DOMAIN=shogun.pjwstk.edu.pl

# ── MariaDB ───────────────────────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=zmien_na_silne_haslo

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASS=zmien_na_silne_haslo
MONGO_DB=pj_sylabi

# ── Keycloak ──────────────────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASS=zmien_na_silne_haslo

# Client secret serwisu Users -- pobierz przez:
#   terraform output -raw users_service_client_secret
USERS_SERVICE_CLIENT_SECRET=
