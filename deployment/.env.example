# Dane połączenia SSH do maszyny GDA-Shogun
# Skopiuj ten plik jako .env i uzupełnij wartości.
# NIGDY nie commituj pliku .env do repozytorium!

# Adres IP lub hostname maszyny docelowej
SSH_HOST=

# Login SSH
SSH_USER=shogun

# Hasło SSH (tymczasowe — zmień po pierwszym logowaniu)
SSH_PASS=

# Port SSH (domyślnie 22)
SSH_PORT=22
