# API
API_PORT=8080

# Keycloak database – używa istniejącego serwera MariaDB (host)
# Utwórz bazę ręcznie: CREATE DATABASE shogun_users CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
KC_DB_USER=root
KC_DB_PASS=password

# Keycloak admin
KC_ADMIN_USER=admin
KC_ADMIN_PASS=admin_pass
